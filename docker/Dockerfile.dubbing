FROM node:24-bookworm-slim AS frontend
WORKDIR /build
COPY frontend/package.json ./
RUN npm install
COPY frontend/ ./
RUN npm run build

FROM python:3.12-slim-bookworm
RUN apt-get update && apt-get install -y --no-install-recommends ffmpeg mkvtoolnix libsndfile1 && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY requirements-dubbing.lock.txt ./
RUN pip install --no-cache-dir -r requirements-dubbing.lock.txt
COPY apps/ apps/
COPY src/ src/
COPY scripts/start.py scripts/start.py
COPY --from=frontend /build/dist frontend/dist
RUN useradd --create-home --uid 1000 app && mkdir /data && chown app:app /data
ENV APP_HOST=0.0.0.0 APP_PORT=7861 APP_DATA_DIR=/data HF_HOME=/data/models PYTHONUTF8=1 PYTHONUNBUFFERED=1
USER app
EXPOSE 7861
CMD ["python", "scripts/start.py", "--headless"]
